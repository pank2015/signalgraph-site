---
import { coverSvg } from "../lib/cover.mjs";

interface Props {
  seed: string;
  pillar?: string;
  class?: string;
}
const { seed, pillar, class: klass } = Astro.props;
const svg = coverSvg(seed, pillar);
---

<div class:list={["cover-art", klass]} set:html={svg} />

<style>
  .cover-art {
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--hairline);
  }
  .cover-art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
