---
/**
 * "Listen to article" — the spoken-narration counterpart to OpenAI's audio
 * player. `src` is a built asset URL from content/audio/<slug>.mp3 (engine
 * step, best-effort — absent on most posts today). Duration is read from the
 * browser's own <audio> metadata, not computed server-side.
 */
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---

<div class="audio-player" data-audio-player>
  <audio preload="metadata" data-audio-el>
    <source src={src} type="audio/mpeg" />
  </audio>
  <button type="button" class="play-toggle" data-play-toggle aria-label={`Play narration of ${title}`}>
    <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"></path></svg>
  </button>
  <span class="label">Listen</span>
  <div class="scrubber" data-scrubber role="slider" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
    <div class="scrubber-fill" data-scrubber-fill></div>
  </div>
  <span class="time" data-time>--:--</span>
  <button type="button" class="speed-toggle" data-speed-toggle aria-label="Playback speed">1x</button>
</div>

<script>
  const SPEEDS = [1, 1.25, 1.5, 2, 0.75];

  function fmt(seconds: number): string {
    if (!isFinite(seconds) || seconds < 0) return "--:--";
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60)
      .toString()
      .padStart(2, "0");
    return `${m}:${s}`;
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-audio-player]").forEach((el) => {
      if (el.dataset.bound === "1") return;
      el.dataset.bound = "1";

      const audio = el.querySelector<HTMLAudioElement>("[data-audio-el]");
      const toggle = el.querySelector<HTMLButtonElement>("[data-play-toggle]");
      const playIcon = el.querySelector<SVGElement>(".icon-play");
      const pauseIcon = el.querySelector<SVGElement>(".icon-pause");
      const scrubber = el.querySelector<HTMLElement>("[data-scrubber]");
      const fill = el.querySelector<HTMLElement>("[data-scrubber-fill]");
      const time = el.querySelector<HTMLElement>("[data-time]");
      const speedBtn = el.querySelector<HTMLButtonElement>("[data-speed-toggle]");
      if (!audio || !toggle || !scrubber || !fill || !time || !speedBtn) return;

      let speedIdx = 0;

      const updateTime = () => {
        const dur = audio.duration || 0;
        time.textContent = dur ? `${fmt(audio.currentTime)} / ${fmt(dur)}` : fmt(dur);
        const pct = dur ? (audio.currentTime / dur) * 100 : 0;
        fill.style.width = `${pct}%`;
        scrubber.setAttribute("aria-valuenow", String(Math.round(pct)));
      };

      toggle.addEventListener("click", () => {
        if (audio.paused) audio.play();
        else audio.pause();
      });

      audio.addEventListener("play", () => {
        playIcon?.setAttribute("hidden", "");
        pauseIcon?.removeAttribute("hidden");
      });
      audio.addEventListener("pause", () => {
        pauseIcon?.setAttribute("hidden", "");
        playIcon?.removeAttribute("hidden");
      });
      audio.addEventListener("loadedmetadata", updateTime);
      audio.addEventListener("timeupdate", updateTime);
      audio.addEventListener("ended", () => {
        pauseIcon?.setAttribute("hidden", "");
        playIcon?.removeAttribute("hidden");
      });

      const seekFromEvent = (clientX: number) => {
        const rect = scrubber.getBoundingClientRect();
        const pct = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        if (audio.duration) audio.currentTime = pct * audio.duration;
      };
      scrubber.addEventListener("click", (e) => seekFromEvent(e.clientX));
      scrubber.addEventListener("keydown", (e) => {
        if (!audio.duration) return;
        if (e.key === "ArrowRight") audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
        else if (e.key === "ArrowLeft") audio.currentTime = Math.max(0, audio.currentTime - 5);
      });

      speedBtn.addEventListener("click", () => {
        speedIdx = (speedIdx + 1) % SPEEDS.length;
        audio.playbackRate = SPEEDS[speedIdx];
        speedBtn.textContent = `${SPEEDS[speedIdx]}x`;
      });

      updateTime();
    });
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>

<style>
  .audio-player {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .play-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--bg-raised);
    color: var(--ink);
    cursor: pointer;
    padding: 0;
    flex: none;
  }
  .play-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .scrubber {
    position: relative;
    width: 100px;
    height: 4px;
    border-radius: 999px;
    background: var(--hairline);
    cursor: pointer;
  }
  .scrubber-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    border-radius: 999px;
    background: var(--accent);
  }
  .time {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .speed-toggle {
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font-family: inherit;
    font-size: inherit;
    padding: 0.15em 0.55em;
    cursor: pointer;
  }
  .speed-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
